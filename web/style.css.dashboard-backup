cat > web/style.css <<'EOF'
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --bg: #070a12;
    --panel: rgba(17, 24, 39, 0.72);
    --panel-soft: rgba(255, 255, 255, 0.035);
    --border: rgba(255, 255, 255, 0.09);
    --text: #f8fafc;
    --muted: #9298a8;
    --accent: #6c63ff;
    --accent-light: #8b82ff;
    --success: #6ee7b7;
    --danger: #fb7185;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    background:
        radial-gradient(
            circle at 50% 0%,
            rgba(39, 50, 110, 0.55),
            transparent 35%
        ),
        radial-gradient(
            circle at 90% 80%,
            rgba(108, 99, 255, 0.10),
            transparent 30%
        ),
        var(--bg);
    color: var(--text);
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    line-height: 1.5;
}

/* =========================
   NAVBAR
========================= */

.navbar {
    height: 76px;
    padding: 0 clamp(20px, 7vw, 100px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    background: rgba(7, 10, 18, 0.55);
    backdrop-filter: blur(18px);
    position: sticky;
    top: 0;
    z-index: 20;
}

.logo {
    font-size: 27px;
    font-weight: 850;
    letter-spacing: -1.5px;
}

.logo span {
    color: var(--accent-light);
}

.badge {
    padding: 6px 10px;
    border: 1px solid rgba(108, 99, 255, 0.3);
    border-radius: 999px;
    font-size: 10px;
    letter-spacing: 1.8px;
    color: #b7b4ff;
    background: rgba(108, 99, 255, 0.08);
}

/* =========================
   HERO
========================= */

.hero {
    width: min(1100px, calc(100% - 32px));
    margin: 0 auto;
    padding: 90px 0 100px;
}

.eyebrow {
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #858b9d;
    margin-bottom: 28px;
}

h1 {
    text-align: center;
    font-size: clamp(46px, 7vw, 82px);
    line-height: 0.98;
    letter-spacing: -4px;
}

h1 span {
    color: var(--accent-light);
}

.subtitle {
    max-width: 650px;
    margin: 28px auto 52px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.75;
    text-align: center;
}

/* =========================
   UPLOAD CARD
========================= */

.upload-card {
    max-width: 720px;
    margin: 0 auto;
    padding: 52px 40px;
    border: 1px solid var(--border);
    border-radius: 26px;
    background: var(--panel);
    backdrop-filter: blur(24px);
    box-shadow:
        0 30px 90px rgba(0, 0, 0, 0.38),
        inset 0 1px 0 rgba(255, 255, 255, 0.04);
    text-align: center;
}

.upload-icon {
    width: 62px;
    height: 62px;
    margin: 0 auto 24px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    background: rgba(108, 99, 255, 0.12);
    border: 1px solid rgba(108, 99, 255, 0.2);
    color: var(--accent-light);
    font-size: 27px;
    box-shadow: 0 10px 30px rgba(108, 99, 255, 0.12);
}

.upload-card h2 {
    font-size: 25px;
    letter-spacing: -0.5px;
    margin-bottom: 10px;
}

.upload-card p {
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 28px;
}

/* =========================
   BUTTONS
========================= */

.upload-button,
.analyze-button,
.import-button,
.results-button {
    min-height: 44px;
    padding: 11px 20px;
    border-radius: 11px;
    border: 1px solid transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    transition:
        transform 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease,
        opacity 0.2s ease;
}

.upload-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: white;
    color: #080910;
}

.upload-button:hover,
.analyze-button:hover:not(:disabled),
.import-button:hover:not(:disabled),
.results-button:hover:not(:disabled) {
    transform: translateY(-2px);
}

.analyze-button,
.import-button,
.results-button {
    color: white;
    background: var(--accent);
    border-color: rgba(139, 130, 255, 0.5);
    box-shadow: 0 8px 22px rgba(108, 99, 255, 0.16);
}

.results-button {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--border);
    box-shadow: none;
}

.results-button:hover {
    background: rgba(255, 255, 255, 0.10);
}

.analyze-button:disabled,
.import-button:disabled,
.results-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
}

.button-row {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 4px;
}

/* =========================
   FILE NAME
========================= */

.file-name {
    min-height: 22px;
    margin: 17px 0;
    color: #b7bdca;
    font-size: 13px;
}

/* =========================
   RESULT CONTAINER
========================= */

.result-card {
    width: 100%;
    max-width: 1000px;
    margin: 32px auto 0;
    padding: 34px;
    border-radius: 24px;
    background: var(--panel);
    border: 1px solid var(--border);
    backdrop-filter: blur(22px);
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.28);
    text-align: left;
}

.result-card h2 {
    font-size: 26px;
    letter-spacing: -0.7px;
    margin-bottom: 20px;
}

.hidden {
    display: none;
}

/* =========================
   STATUS
========================= */

.success {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    margin-bottom: 20px;
    border-radius: 999px;
    color: var(--success);
    background: rgba(110, 231, 183, 0.08);
    border: 1px solid rgba(110, 231, 183, 0.15);
    font-size: 12px;
    font-weight: 700;
}

.error {
    display: inline-flex;
    padding: 8px 12px;
    border-radius: 9px;
    color: var(--danger);
    background: rgba(251, 113, 133, 0.08);
    border: 1px solid rgba(251, 113, 133, 0.15);
    font-size: 13px;
    font-weight: 700;
}

/* =========================
   IMPORT STATS
========================= */

.stat {
    padding: 15px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: space-between;
    color: var(--muted);
}

.stat strong {
    color: white;
}

/* =========================
   STUDENT RESULTS
========================= */

.student-result {
    margin-top: 18px;
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.025);
    transition:
        border-color 0.2s ease,
        background 0.2s ease,
        transform 0.2s ease;
}

.student-result:hover {
    transform: translateY(-2px);
    border-color: rgba(108, 99, 255, 0.28);
    background: rgba(108, 99, 255, 0.035);
}

.student-result h3 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    font-size: 17px;
    margin-bottom: 8px;
}

.student-result h3 span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    padding: 5px 9px;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.05);
}

.student-result > p {
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 16px;
}

.student-result > p strong {
    color: white;
}

/* =========================
   COURSE RESULTS
========================= */

.course-results {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.course-result {
    min-height: 70px;
    padding: 13px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.055);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 7px;
}

.course-result strong {
    font-size: 12px;
    line-height: 1.35;
    color: #e9ebf2;
}

.course-result span {
    color: var(--accent-light);
    font-size: 12px;
    font-weight: 700;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 800px) {
    .hero {
        padding-top: 65px;
    }

    .course-results {
        grid-template-columns: 1fr;
    }

    .result-card {
        padding: 24px;
    }
}

@media (max-width: 600px) {
    .navbar {
        height: 68px;
    }

    .badge {
        font-size: 8px;
        letter-spacing: 1px;
    }

    .hero {
        width: min(100% - 20px, 1000px);
        padding: 55px 0 70px;
    }

    h1 {
        letter-spacing: -2.5px;
    }

    .subtitle {
        font-size: 15px;
        margin-bottom: 35px;
    }

    .upload-card {
        padding: 35px 20px;
        border-radius: 20px;
    }

    .button-row {
        flex-direction: column;
    }

    .analyze-button,
    .import-button,
    .results-button {
        width: 100%;
    }

    .result-card {
        padding: 18px;
        border-radius: 18px;
    }

    .student-result {
        padding: 16px;
    }

    .student-result h3 {
        align-items: flex-start;
        flex-direction: column;
        gap: 7px;
    }
}
EOF